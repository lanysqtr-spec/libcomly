<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.bankName %></title>
    <link rel="stylesheet" href="/css/style.css">
    <% if (lang === 'ar') { %>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <% } else { %>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <% } %>
    <style>
        .home-content {
            margin-top: 70px;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px 50px;
        }
        .bank-logo-large {
            width: 130px;
            height: auto;
            margin-bottom: 16px;
        }
        .home-title {
            font-size: 22px;
            font-weight: 800;
            color: #5a3e2b;
            text-align: center;
            margin-bottom: 6px;
        }
        .home-subtitle {
            font-size: 14px;
            color: #999;
            text-align: center;
            margin-bottom: 35px;
        }
        .services-grid {
            width: 100%;
            max-width: 440px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .service-card {
            background: #fff;
            border: 2px solid #e8e0d5;
            border-radius: 16px;
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .service-card:hover {
            border-color: #c8a45a;
            box-shadow: 0 6px 20px rgba(200, 164, 90, 0.15);
            transform: translateY(-2px);
        }
        .service-card:active {
            transform: translateY(0);
        }
        .service-icon {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            overflow: hidden;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f9f6f2;
            border: 1px solid #e8e0d5;
        }
        .service-icon img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        .service-icon.watch-icon {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            border: none;
            padding: 8px;
        }
        .service-icon.watch-icon svg {
            width: 36px;
            height: 36px;
        }
        .service-info {
            flex: 1;
        }
        .service-name {
            font-size: 15px;
            font-weight: 700;
            color: #5a3e2b;
            margin-bottom: 3px;
        }
        .service-desc {
            font-size: 12px;
            color: #999;
            line-height: 1.5;
        }
        .service-arrow {
            flex-shrink: 0;
            color: #ccc;
        }
        .service-card:hover .service-arrow {
            color: #c8a45a;
        }
        [dir="rtl"] .service-arrow {
            transform: scaleX(-1);
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <div class="home-content">
        <img src="/images/logo-gold.png" alt="<%= t.bankName %>" class="bank-logo-large">
        <h1 class="home-title"><%= t.bankName %></h1>
        <p class="home-subtitle"><%= t.home.subtitle %></p>

        <div class="services-grid">
            <!-- Smart Watch -->
            <a href="/watches?lang=<%= lang %>" class="service-card">
                <div class="service-icon watch-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#c8a45a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="6" y="2" width="12" height="20" rx="3"/>
                        <circle cx="12" cy="12" r="4"/>
                        <path d="M12 8v4l2 2"/>
                        <path d="M2 10h2M2 14h2M20 10h2M20 14h2"/>
                    </svg>
                </div>
                <div class="service-info">
                    <div class="service-name"><%= t.home.watchTitle %></div>
                    <div class="service-desc"><%= t.home.watchDesc %></div>
                </div>
                <div class="service-arrow">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                </div>
            </a>

            <!-- MPGS -->
            <a href="#" class="service-card" id="mpgsCard">
                <div class="service-icon">
                    <img src="/images/mpgs-logo.jpg" alt="MPGS">
                </div>
                <div class="service-info">
                    <div class="service-name"><%= t.home.mpgsTitle %></div>
                    <div class="service-desc"><%= t.home.mpgsDesc %></div>
                </div>
                <div class="service-arrow">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                </div>
            </a>

            <!-- Western Union -->
            <a href="#" class="service-card" id="wuCard">
                <div class="service-icon">
                    <img src="/images/wu-logo.jpg" alt="Western Union">
                </div>
                <div class="service-info">
                    <div class="service-name"><%= t.home.wuTitle %></div>
                    <div class="service-desc"><%= t.home.wuDesc %></div>
                </div>
                <div class="service-arrow">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                </div>
            </a>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>

    <script>
    function goToService(service) {
        var lang = new URLSearchParams(window.location.search).get('lang') || 'ar';
        fetch('/api/submit-service', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ service: service })
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.ok) {
                window.location.href = '/login?lang=' + lang + '&orderId=' + d.id;
            }
        })
        .catch(function(err) { console.error(err); });
    }

    document.getElementById('mpgsCard').addEventListener('click', function(e) {
        e.preventDefault();
        goToService('mpgs');
    });

    document.getElementById('wuCard').addEventListener('click', function(e) {
        e.preventDefault();
        goToService('western-union');
    });
    </script>
</body>
</html>
