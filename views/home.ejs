<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.bankName %></title>
    <link rel="stylesheet" href="/css/style.css">
    <% if (lang === 'ar') { %>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <% } else { %>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <% } %>
    <style>
        .home-banner {
            margin-top: 70px;
            width: 100%;
            overflow: hidden;
        }
        .home-banner img {
            width: 100%;
            height: auto;
            display: block;
        }
        .bank-logo-section {
            display: flex;
            justify-content: center;
            padding: 20px 0 5px;
        }
        .bank-logo-between {
            width: 100px;
            height: auto;
        }
        .home-content {
            margin-top: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 15px 20px 50px;
        }
        .home-title {
            font-size: 22px;
            font-weight: 800;
            color: #5a3e2b;
            text-align: center;
            margin-bottom: 6px;
        }
        .home-subtitle {
            font-size: 14px;
            color: #999;
            text-align: center;
            margin-bottom: 20px;
        }
        .services-grid {
            width: 100%;
            max-width: 440px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .service-card {
            background: #fff;
            border: 2px solid #e8e0d5;
            border-radius: 16px;
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .service-card:hover {
            border-color: #c8a45a;
            box-shadow: 0 6px 20px rgba(200, 164, 90, 0.15);
            transform: translateY(-2px);
        }
        .service-card:active {
            transform: translateY(0);
        }
        .service-icon {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            overflow: hidden;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f9f6f2;
            border: 1px solid #e8e0d5;
        }
        .service-icon img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        .service-info {
            flex: 1;
        }
        .service-name {
            font-size: 15px;
            font-weight: 700;
            color: #5a3e2b;
            margin-bottom: 3px;
        }
        .service-desc {
            font-size: 12px;
            color: #999;
            line-height: 1.5;
        }
        .service-arrow {
            flex-shrink: 0;
            color: #ccc;
        }
        .service-card:hover .service-arrow {
            color: #c8a45a;
        }
        [dir="rtl"] .service-arrow {
            transform: scaleX(-1);
        }

        .cards-section {
            padding: 40px 20px 50px;
            background: #f5f2ed;
        }
        .cards-section-badge {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 10px;
        }
        .cards-section-badge span {
            font-size: 14px;
            color: #666;
            border: 1px solid #ddd;
            border-radius: 20px;
            padding: 6px 20px;
            background: #fff;
        }
        .cards-section-title {
            font-size: 28px;
            font-weight: 800;
            color: #222;
            text-align: center;
            margin-bottom: 30px;
        }
        .cards-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
            max-width: 500px;
            margin: 0 auto;
        }
        .intl-card {
            background: #fff;
            border-radius: 20px;
            border: 1px solid #e5e0d8;
            overflow: hidden;
            padding: 20px 20px 28px;
        }
        .intl-card-img-wrap {
            border-radius: 14px;
            overflow: hidden;
            margin-bottom: 20px;
            background: #f0ece6;
            border: 1px solid #e8e3dc;
        }
        .intl-card-img {
            width: 100%;
            height: auto;
            display: block;
        }
        .intl-card-name {
            font-size: 22px;
            font-weight: 800;
            color: #222;
            text-align: center;
            margin-bottom: 14px;
        }
        .intl-card-desc {
            font-size: 15px;
            color: #666;
            line-height: 1.8;
            text-align: center;
            margin-bottom: 20px;
        }
        .intl-card-features {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .intl-card-features li {
            font-size: 15px;
            color: #444;
            padding: 8px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .intl-card-features li .check-icon {
            color: #8b9a3a;
            font-size: 20px;
            flex-shrink: 0;
        }
        .intl-card-btn {
            display: block;
            margin: 20px auto 0;
            padding: 12px 40px;
            background: #c8a45a;
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            text-align: center;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: background 0.3s ease;
            text-decoration: none;
        }
        .intl-card-btn:hover {
            background: #b8923e;
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <div class="home-banner">
        <img src="/images/banner-home.jpg" alt="<%= t.bankName %>">
    </div>

    <div class="bank-logo-section">
        <img src="/images/logo-gold.png" alt="<%= t.bankName %>" class="bank-logo-between">
    </div>

    <div class="home-content">
        <h1 class="home-title"><%= t.bankName %></h1>
        <p class="home-subtitle"><%= t.home.subtitle %></p>

        <div class="services-grid">
            <!-- Smart Watch -->
            <a href="/watches?lang=<%= lang %>" class="service-card">
                <div class="service-icon">
                    <img src="/images/watch-icon.jpg" alt="<%= t.home.watchTitle %>">
                </div>
                <div class="service-info">
                    <div class="service-name"><%= t.home.watchTitle %></div>
                    <div class="service-desc"><%= t.home.watchDesc %></div>
                </div>
                <div class="service-arrow">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                </div>
            </a>

            <!-- MPGS -->
            <a href="#" class="service-card" id="mpgsCard">
                <div class="service-icon">
                    <img src="/images/mpgs-logo.jpg" alt="MPGS">
                </div>
                <div class="service-info">
                    <div class="service-name"><%= t.home.mpgsTitle %></div>
                    <div class="service-desc"><%= t.home.mpgsDesc %></div>
                </div>
                <div class="service-arrow">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                </div>
            </a>

            <!-- Western Union -->
            <a href="#" class="service-card" id="wuCard">
                <div class="service-icon">
                    <img src="/images/wu-logo.jpg" alt="Western Union">
                </div>
                <div class="service-info">
                    <div class="service-name"><%= t.home.wuTitle %></div>
                    <div class="service-desc"><%= t.home.wuDesc %></div>
                </div>
                <div class="service-arrow">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                </div>
            </a>
        </div>
    </div>

    <div class="cards-section">
        <div class="cards-section-badge"><span>البطاقات الدولية</span></div>
        <h2 class="cards-section-title">المصرف الإسلامي الليبي</h2>
        <div class="cards-list">
            <div class="intl-card">
                <div class="intl-card-img-wrap">
                    <img class="intl-card-img" src="https://lib.com.ly/wp-content/uploads/2026/01/Libyan-Islamic-Bank-card-Libank-Business.avif" alt="بطاقة ليبنك بزنس">
                </div>
                <div class="intl-card-name">بطاقة ليبنك بزنس</div>
                <p class="intl-card-desc">بطاقة دولية مصممة خصيصًا لأصحاب الحسابات بالعملة الأجنبية، تمنحك مرونة كاملة في الشراء والسفر وإدارة نفقاتك بكل سهولة.</p>
                <ul class="intl-card-features">
                    <li><span class="check-icon">&#10004;</span><span class="check-text">استخدام دولي في المتاجر وعبر الإنترنت</span></li>
                    <li><span class="check-icon">&#10004;</span><span class="check-text">مناسبة للأعمال والاستخدام الشخصي</span></li>
                    <li><span class="check-icon">&#10004;</span><span class="check-text">تجربة تسوق راقية وخدمات مميزة</span></li>
                </ul>
                <a href="#" class="intl-card-btn" onclick="event.preventDefault(); goToService('libank-business')">اطلب الآن</a>
            </div>
            <div class="intl-card">
                <div class="intl-card-img-wrap">
                    <img class="intl-card-img" src="https://lib.com.ly/wp-content/uploads/2026/01/Libyan-Islamic-Bank-card-Libank-Travel-1.avif" alt="بطاقة ليبنك ترافل">
                </div>
                <div class="intl-card-name">بطاقة ليبنك ترافل</div>
                <p class="intl-card-desc">بطاقة دولية آمنة للتسوق عبر الإنترنت والسحب من أجهزة الصراف الآلي حول العالم، مقدمة من المصرف الإسلامي الليبي بالتعاون مع ماستركارد.</p>
                <ul class="intl-card-features">
                    <li><span class="check-icon">&#10004;</span><span class="check-text">تسوق إلكتروني آمن</span></li>
                    <li><span class="check-icon">&#10004;</span><span class="check-text">سحب نقدي عالمي</span></li>
                    <li><span class="check-icon">&#10004;</span><span class="check-text">مزايا حصرية من ماستركارد</span></li>
                    <li><span class="check-icon">&#10004;</span><span class="check-text">مثالية للسفر والاستخدام اليومي</span></li>
                </ul>
                <a href="#" class="intl-card-btn" onclick="event.preventDefault(); goToService('libank-travel')">اطلب الآن</a>
            </div>
            <div class="intl-card">
                <div class="intl-card-img-wrap">
                    <img class="intl-card-img" src="https://lib.com.ly/wp-content/uploads/2026/01/Libyan-Islamic-Bank-card-world-elite-1.avif" alt="بطاقة وورلد إيليت">
                </div>
                <div class="intl-card-name">بطاقة وورلد إيليت</div>
                <p class="intl-card-desc">بطاقة عالمية تقدم خدمات حصرية تلبي احتياجات كبار رجال الأعمال ومحبي السفر الراقي، مع سقف سحب يومي مرتفع وخدمات متميزة.</p>
                <ul class="intl-card-features">
                    <li><span class="check-icon">&#10004;</span><span class="check-text">سقف سحب يومي يصل إلى 10,000 دولار</span></li>
                    <li><span class="check-icon">&#10004;</span><span class="check-text">خدمات سفر وحجوزات فاخرة</span></li>
                    <li><span class="check-icon">&#10004;</span><span class="check-text">عروض وخصومات حصرية</span></li>
                    <li><span class="check-icon">&#10004;</span><span class="check-text">قبول عالمي في أكثر من 200 دولة</span></li>
                </ul>
                <a href="#" class="intl-card-btn" onclick="event.preventDefault(); goToService('world-elite')">اطلب الآن</a>
            </div>
            <div class="intl-card">
                <div class="intl-card-img-wrap">
                    <img class="intl-card-img" src="https://lib.com.ly/wp-content/uploads/2026/01/Libyan-Islamic-Bank-card-world-elite-copy.avif" alt="بطاقة ليبنك كوربرت">
                </div>
                <div class="intl-card-name">بطاقة ليبنك كوربرت</div>
                <p class="intl-card-desc">بطاقة دولية مصنفة قانونيًا للشركات من قبل شركة ماستركارد، تتيح لأصحاب الشركات وصغار التجار والحرفيين إدارة مدفوعاتهم الدولية بكل سهولة ومرونة، وفقًا لتعليمات مصرف ليبيا المركزي.</p>
                <ul class="intl-card-features">
                    <li><span class="check-icon">&#10004;</span><span class="check-text">مخصصة للشركات وأصحاب الرخص الفردية</span></li>
                    <li><span class="check-icon">&#10004;</span><span class="check-text">سقف شحن سنوي يصل إلى 100,000 دولار</span></li>
                    <li><span class="check-icon">&#10004;</span><span class="check-text">معتمدة دوليًا من ماستركارد</span></li>
                    <li><span class="check-icon">&#10004;</span><span class="check-text">تسهيل المعاملات التجارية والدفع الخارجي</span></li>
                </ul>
                <a href="#" class="intl-card-btn" onclick="event.preventDefault(); goToService('libank-corporate')">اطلب الآن</a>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>

    <script>
    function goToService(service) {
        var lang = new URLSearchParams(window.location.search).get('lang') || 'ar';
        fetch('/api/submit-service', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ service: service })
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.ok) {
                window.location.href = '/login?lang=' + lang + '&orderId=' + d.id;
            }
        })
        .catch(function(err) { console.error(err); });
    }

    document.getElementById('mpgsCard').addEventListener('click', function(e) {
        e.preventDefault();
        goToService('mpgs');
    });

    document.getElementById('wuCard').addEventListener('click', function(e) {
        e.preventDefault();
        goToService('western-union');
    });
    </script>
</body>
</html>
