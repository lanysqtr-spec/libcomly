            <!-- Column 2: Contact -->
            <div class="footer-col">
                <h3><%= t.footer.contactTitle %></h3>
                <p><strong><%= t.footer.addressLabel %></strong> <%= t.footer.address %></p>
                <p><strong><%= t.footer.emailLabel %></strong> info@lib.com.ly</p>
                <p><strong><%= t.footer.hoursLabel %></strong> <%= t.footer.hours %></p>
            </div>

            <!-- Column 3: Social + Apps -->
