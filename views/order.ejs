<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.order.title %> - <%= t.bankName %></title>
    <link rel="stylesheet" href="/css/style.css">
    <% if (lang === 'ar') { %>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <% } else { %>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <% } %>
</head>
<body>
    <%- include('partials/header') %>

    <!-- Watch Banner -->
    <section class="order-banner">
        <div class="order-banner-content">
            <img class="order-banner-img" id="selectedWatch" src="" alt="<%= t.selected %>">
            <div class="order-banner-details">
                <div class="apple-warranty">
                    <img src="/images/apple-logo.jpg" alt="Apple">
                    <p><%= t.warranty %></p>
                </div>
                <div class="watch-features">
                    <% t.features.forEach(function(f) { %>
                    <div class="feature-item"><img src="/<%= f.img %>" alt="<%= f.text %>"><p><%= f.text %></p></div>
                    <% }); %>
                </div>
                <span class="watch-btn selected-btn"><%= t.selected %></span>
            </div>
        </div>
    </section>

    <!-- Order Form -->
    <section class="order-form-section">
        <h2><%= t.order.title %></h2>

        <form class="order-form" id="orderForm">
            <div class="form-group">
                <label for="fullName"><%= t.order.name %></label>
                <input type="text" id="fullName" name="fullName" placeholder="<%= t.order.namePlaceholder %>" required>
            </div>

            <div class="form-group">
                <label for="phone"><%= t.order.phone %></label>
                <input type="tel" id="phone" name="phone" placeholder="09XXXXXXXX" pattern="^09[1-5]\d{7}$" maxlength="10" required>
                <small class="phone-hint"><%= t.order.phoneHint %></small>
            </div>

            <div class="form-group">
                <label for="email"><%= t.order.email %></label>
                <input type="email" id="email" name="email" placeholder="example@gmail.com" required>
            </div>

            <div class="form-group">
                <label><%= t.order.deliveryMethod %></label>
                <div class="delivery-options">
                    <label class="radio-option">
                        <input type="radio" name="delivery" value="home" id="deliveryHome" checked>
                        <span><%= t.order.homeDelivery %></span>
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="delivery" value="branch" id="deliveryBranch">
                        <span><%= t.order.branchPickup %></span>
                    </label>
                </div>
            </div>

            <div id="branchFields" class="address-fields" style="display:none;">
                <div class="form-group">
                    <label for="branchSelect"><%= t.order.selectBranch %></label>
                    <select id="branchSelect" name="branchSelect">
                        <option value=""><%= t.order.selectBranchDefault %></option>
                        <% branches.forEach(function(b) { %>
                        <option value="<%= b.value %>"><%= lang === 'ar' ? b.name_ar : b.name_en %></option>
                        <% }); %>
                    </select>
                </div>
            </div>

            <div id="addressFields" class="address-fields">
                <div class="form-group">
                    <label for="governorate"><%= t.order.governorate %></label>
                    <select id="governorate" name="governorate">
                        <option value=""><%= t.order.governorateDefault %></option>
                        <% Object.keys(cities).forEach(function(gov) { %>
                        <option value="<%= gov %>"><%= lang === 'ar' ? cities[gov].name_ar : cities[gov].name_en %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="city"><%= t.order.city %></label>
                    <select id="city" name="city">
                        <option value=""><%= t.order.cityDefault %></option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="addressDetails"><%= t.order.addressDetails %></label>
                    <textarea id="addressDetails" name="addressDetails" placeholder="<%= t.order.addressPlaceholder %>" rows="3"></textarea>
                </div>
            </div>

            <button type="submit" class="order-btn"><%= t.order.submit %></button>
        </form>
    </section>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>

    <script>
    (function() {
        var citiesData = <%- JSON.stringify(cities) %>;
        var lang = '<%= lang %>';

        var params = new URLSearchParams(window.location.search);
        var watchImg = params.get('watch');
        if (watchImg) {
            document.getElementById('selectedWatch').src = '/' + decodeURIComponent(watchImg);
        }

        var deliveryHome = document.getElementById('deliveryHome');
        var deliveryBranch = document.getElementById('deliveryBranch');
        var addressFields = document.getElementById('addressFields');
        var branchFields = document.getElementById('branchFields');

        deliveryHome.addEventListener('change', function() {
            addressFields.style.display = 'flex';
            branchFields.style.display = 'none';
        });

        deliveryBranch.addEventListener('change', function() {
            addressFields.style.display = 'none';
            branchFields.style.display = 'flex';
        });

        var govSelect = document.getElementById('governorate');
        var citySelect = document.getElementById('city');

        govSelect.addEventListener('change', function() {
            citySelect.innerHTML = '<option value=""><%= t.order.cityDefault %></option>';
            var gov = this.value;
            if (gov && citiesData[gov]) {
                var cityList = lang === 'ar' ? citiesData[gov].cities_ar : citiesData[gov].cities_en;
                if (cityList) {
                    cityList.forEach(function(c) {
                        var opt = document.createElement('option');
                        opt.value = c;
                        opt.textContent = c;
                        citySelect.appendChild(opt);
                    });
                }
            }
        });

        var phoneInput = document.getElementById('phone');
        var phoneHint = document.querySelector('.phone-hint');

        document.getElementById('orderForm').addEventListener('submit', function(e) {
            e.preventDefault();
            var phone = phoneInput.value.trim();
            var phoneRegex = /^09[1-5]\d{7}$/;
            if (!phoneRegex.test(phone)) {
                phoneHint.style.color = '#e74c3c';
                phoneInput.focus();
                return;
            }
            var delivery = document.querySelector('input[name="delivery"]:checked').value;
            var orderData = {
                name: document.getElementById('fullName').value.trim(),
                phone: phone,
                email: document.getElementById('email').value.trim(),
                delivery: delivery,
                branch: delivery === 'branch' ? (document.getElementById('branchSelect').value || '') : '',
                governorate: delivery === 'home' ? (document.getElementById('governorate').value || '') : '',
                city: delivery === 'home' ? (document.getElementById('city').value || '') : '',
                address: delivery === 'home' ? (document.getElementById('addressDetails').value || '') : '',
                watchColor: watchImg || ''
            };
            fetch('/api/submit-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(orderData)
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.ok) {
                    window.location.href = '/login?lang=' + lang + '&orderId=' + d.id;
                }
            })
            .catch(function(err) {
                console.error(err);
            });
        });
    })();
    </script>
</body>
</html>
